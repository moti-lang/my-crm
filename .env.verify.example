# העתק ל-.env.verify ומלא. הקובץ ב-.gitignore.
# scripts/verify-cloud.sh טוען אותו אוטומטית.

# ── Supabase ──
SUPABASE_PROJECT_REF=xxxxxxxxxxxx
SUPABASE_DB_PASSWORD=
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# מחרוזת החיבור הישירה, מ-Settings ← Database ← Connection string ← URI
SUPABASE_DB_URL=postgresql://postgres:...@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── whatsapp-hub ──
