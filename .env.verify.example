# העתק ל-.env.verify ומלא. הקובץ ב-.gitignore.
# scripts/verify-cloud.sh טוען אותו אוטומטית.

# ── Supabase ──
# שני אלה אופציונליים: אם הם ריקים, המיגרציות מוחלות דרך SUPABASE_DB_URL
# ב-psql במקום דרך supabase link. אותן 13 מיגרציות, אותו סדר.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# מחרוזת החיבור הישירה, מ-Settings ← Database ← Connection string ← URI
SUPABASE_DB_URL=postgresql://postgres:...@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# מסלול שלישי, כשפורט 5432 חסום ורק HTTPS יוצא (סנדבוקס, CI מוגבל):
# Personal Access Token מ-supabase.com/dashboard/account/tokens.
# מיגרציות, seed והבדיקות רצות אז דרך ה-Management API; מפתח ה-anon
# וסגירת ההרשמה העצמית נמשכים ממנו אוטומטית. סוד ברמת החשבון — לא לשתף.
SUPABASE_ACCESS_TOKEN=

# ── גוגל (OAuth client מ-Google Cloud ← Credentials). נקבעים בפרויקט
# דרך scripts/supabase-project.mjs auth. הסוד לעולם לא בקידומת VITE_. ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# הבעלים הראשונה (ברירת מחדל: מה שב-supabase/seed_allowlist.sql)
OWNER_EMAIL=moti@automation1.co.il

# ── whatsapp-hub ──
WA_SERVER_URL=https://hub.example.com
WA_API_KEY=
# מספר לבדיקה — לא המספר של הניה
WA_TEST_PHONE=972500000000

# ── פרונט (זהים לערכי Supabase שלמעלה) ──
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
SITE_URL=https://teichtal.netlify.app

# ── Netlify (אופציונלי — בלעדיו dist/ נגרר ידנית) ──
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# ── דגלי הרצה יבשה. להשאיר true עד שסבב האימות עובר. ──
WA_DRY_RUN=true
AI_DRY_RUN=true

# ── Anthropic ──
ANTHROPIC_API_KEY=
