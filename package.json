{
  "name": "teichtal-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "db:reset": "supabase db reset && npm run seed:users",
    "db:reset:local": "./supabase/tests/reset.sh",
    "seed:users": "node scripts/seed-users.mjs",
    "db:test": "./supabase/tests/run.sh",
    "db:test:negative": "./supabase/tests/negative-control.sh",
    "gen:types": "node scripts/gen-types.mjs --from-local-postgres > src/lib/database.types.ts",
    "test:wa": "node supabase/tests/wa-contract.test.mjs",
    "test:alerts": "node supabase/tests/alert-independence.test.mjs",
    "test:template": "node supabase/tests/template-parity.test.mjs",
    "test:router": "node supabase/tests/command-router.test.mjs",
    "test:purity": "node supabase/tests/ai-command-purity.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.0",
    "date-fns": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "supabase": "^1.200.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
