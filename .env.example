# ===== חובה =====
# חיבור ל-PostgreSQL (Neon / Supabase / מקומי). למיגרציות ב-Supabase השתמשו בכתובת ה-Session pooler או ב-Direct.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/crm?schema=public"
# אופציונלי: חיבור ישיר (בלי pooler) למיגרציות. אם לא מוגדר — משתמשים ב-DATABASE_URL.
# האינטגרציות של Vercel (Neon / Supabase) מגדירות אוטומטית DATABASE_URL_UNPOOLED / POSTGRES_URL_NON_POOLING וזה מזוהה לבד.
# DIRECT_DATABASE_URL=""

# סיסמת הכניסה (משתמש יחיד). AUTH_SECRET משמש לחתימת ה-cookie (מחרוזת אקראית ארוכה).
APP_PASSWORD="change-me"
AUTH_SECRET="change-me-to-a-long-random-string"
# לפיתוח מקומי בלבד — מדלג על מסך הכניסה:
# AUTH_DISABLED=1

# ===== פירוק טקסט חופשי (שלב 4) =====
# בלי מפתח — ההוספה המהירה עובדת עם מפרש מקומי בסיסי (בלי Claude).
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-5"

# ===== התראות Web Push (שלב 3) =====
# יצירה: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ===== ערוץ גיבוי — וואטסאפ דרך Green API (אופציונלי) =====
GREEN_API_ID_INSTANCE=""
GREEN_API_TOKEN=""
# המספר שאליו נשלח הדיגסט, בפורמט בינלאומי בלי + (למשל 972501234567)
WHATSAPP_TO=""

# ===== Cron =====
# Vercel שולח Authorization: Bearer <CRON_SECRET> לכל קריאת cron. חובה בפרודקשן.
CRON_SECRET="change-me-cron-secret"

# כתובת האתר (לקישורים בהתראות)
APP_URL="http://localhost:3000"
